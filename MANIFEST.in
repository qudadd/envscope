include README.en.md AGENTS.md CONTRIBUTING.md SECURITY.md THIRD_PARTY_NOTICES.md
include start-windows.cmd start-macos.command .gitattributes .gitignore
recursive-include docs *.md *.json *.png
recursive-include licenses *.txt
recursive-include scripts *.py
recursive-include tests *.py *.mjs
recursive-include .github *.md *.yml
global-exclude __pycache__ *.py[cod] *.private.json
